# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.virtual_documents/
anaconda_projects/
.pytest_cache/

# Local-only verification tests — not part of the shipped repo
tests/

# Virtual environments
venv/
env/
.venv/

# Data — downloaded, extracted, and preprocessed locally. Never commit.
# Covers: data/single_pendulum.zip, data/single_pendulum/**, data/pendulum_preprocessed.npz
data/
*.npy
*.zip

# Large training artifacts (committed checkpoints in checkpoints/ are allow-listed below)
results/
*.h5

# Notebook output figures (regenerable)
Figures/
Figures_*/

# Allow the shipped checkpoints and figure_data. This negation block must come
# BEFORE the more specific excludes below — gitignore uses last-match-wins, so
# a broad "!checkpoints/**" appearing after "checkpoints/newrun_*.pt" would
# silently re-include the very files that pattern means to exclude.
!checkpoints/
!checkpoints/**
!figure_data/
!figure_data/**

# New-run figure data and checkpoints (local, not shipped) — must stay after
# the allow-list negations above.
figure_data_*/
checkpoints/newrun_*.pt
checkpoints/test_run.pt

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
